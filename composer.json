{
    "name": "trydoku/php-sdk",
    "description": "Official PHP client for the TRYDOKU document generation API",
    "type": "library",
    "license": "MIT",
    "keywords": ["trydoku", "document-generation", "docx", "pdf", "api", "sdk"],
    "homepage": "https://www.trydoku.com",
    "support": {
        "email": "support@trydoku.com",
        "docs": "https://www.trydoku.com/docs/api"
    },
    "authors": [
        {
            "name": "TRYDOKU",
            "email": "support@trydoku.com",
            "homepage": "https://www.trydoku.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1|^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "phpunit/phpunit": "^11.0",
        "infection/infection": "^0.29",
        "php-cs-fixer/shim": "^3.0",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP client for Laravel and standalone PHP projects (^7.0)",
        "symfony/http-client": "PSR-18 HTTP client for Symfony projects (^6.4|^7.0)",
        "nyholm/psr7": "Lightweight PSR-17 message factory, pairs well with symfony/http-client (^1.8)"
    },
    "autoload": {
        "psr-4": {
            "Trydoku\\": "src/Trydoku/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Trydoku\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "format": "php-cs-fixer fix",
        "analyse": "phpstan analyse",
        "cs": "phpcs --warning-severity=0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "php-http/discovery": true
        }
    }
}
